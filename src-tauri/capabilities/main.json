{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. It is the only window that may call app commands.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir",
    "clipboard-manager:allow-write-text",
    "allow-app-info",
    "allow-list-chats",
    "allow-create-chat",
    "allow-get-chat",
    "allow-rename-chat",
    "allow-delete-chat",
    "allow-set-chat-model",
    "allow-set-system-prompt",
    "allow-switch-branch",
    "allow-send-message",
    "allow-regenerate",
    "allow-stop-generation",
    "allow-runtime-status",
    "allow-list-backends",
    "allow-load-local-model",
    "allow-unload-model",
    "allow-list-model-options",
    "allow-get-local-model-settings",
    "allow-set-local-model-settings",
    "allow-run-diagnostics",
    "allow-list-providers",
    "allow-save-provider",
    "allow-delete-provider",
    "allow-test-provider",
    "allow-get-setting",
    "allow-set-setting",
    "allow-hardware-info",
    "allow-hub-search",
    "allow-hub-search-next",
    "allow-hub-repo",
    "allow-hub-token-status",
    "allow-hub-set-token",
    "allow-hub-clear-token",
    "allow-download-start",
    "allow-download-catalog-entry",
    "allow-download-pause",
    "allow-download-resume",
    "allow-download-cancel",
    "allow-list-downloads",
    "allow-list-installed-models",
    "allow-import-model",
    "allow-delete-model",
    "allow-disk-usage",
    "allow-set-models-dir",
    "allow-first-run-info",
    "allow-complete-first-run",
    "allow-refresh-catalog",
    "allow-list-packs",
    "allow-download-pack",
    "allow-cancel-pack-download",
    "allow-remove-pack",
    "allow-get-hf-endpoint",
    "allow-set-hf-endpoint",
    "allow-get-attachment"
  ]
}
