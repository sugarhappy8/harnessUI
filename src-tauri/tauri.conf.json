{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "harnessUI",
  "version": "0.0.3",
  "identifier": "io.github.sugarhappy8.harnessui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      },
      {
        "label": "overlay",
        "create": false,
        "url": "overlay.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "indicator",
        "create": false,
        "url": "indicator.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "width": 460,
        "height": 52
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src artifact://sandbox.localhost http://artifact.sandbox.localhost; form-action 'none'; base-uri 'self'; require-trusted-types-for 'script'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": true,
      "capabilities": [
        "main",
        "overlay",
        "indicator"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first agentic desktop app for local AI models",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    }
  }
}
