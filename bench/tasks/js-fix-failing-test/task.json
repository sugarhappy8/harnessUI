{
  "title": "Fix a bug found by a failing test (JavaScript)",
  "kind": "javascript",
  "needs": "node",
  "prompt": "The tests of this small JavaScript project fail. Run them with `{node} test.js`, find the bug in slugify.js and fix it. Do not change test.js.",
  "checks": [
    {
      "type": "run",
      "script": "verify.cjs",
      "expect": {
        "hello": {
          "value": "hello-world"
        },
        "spaces": {
          "value": "many-spaces"
        },
        "ready": {
          "value": "ready-go"
        },
        "slugged": {
          "value": "already-slugged"
        },
        "plain": {
          "value": "plain"
        }
      }
    },
    {
      "type": "unchanged",
      "file": "test.js"
    }
  ],
  "parse": [
    "js"
  ]
}
